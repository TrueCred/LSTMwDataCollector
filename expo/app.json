{
  "expo": {
    "name": "TrueCred",
    "slug": "truecred",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#0A0A0F"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.truecred.app"
    },
    "android": {
      "package": "com.truecred.app"
    },
    "plugins": [
      [
        "expo-sensors",
        {
          "motionPermission": "TrueCred uses device motion to verify your identity."
        }
      ]
    ]
  }
}